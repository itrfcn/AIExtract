# ===== LLM Provider =====
# auto | openai | deepseek | ollama
# auto：根据 LLM_BASE_URL 推断 deepseek 或 openai；没填则默认 openai
# openai / deepseek 需要 LLM_API_KEY；ollama（本地模型）无需 key
LLM_PROVIDER=auto

# OpenAI 兼容接口地址；留空则按 provider 使用默认值
# OpenAI:    https://api.openai.com/v1
# DeepSeek:  https://api.deepseek.com/v1
# Ollama:    http://localhost:11434/v1
LLM_BASE_URL=
LLM_API_KEY=
# 留空则按 provider 使用默认模型（gpt-4o-mini / deepseek-chat / qwen2.5:7b）
LLM_MODEL=

# ===== 批量与限速 =====
BATCH_CONCURRENCY=4
LLM_QPS=3
LLM_MAX_RETRIES=3
LLM_TIMEOUT=60

# ===== OCR（扫描件 / 图片）=====
# vision：云端视觉模型读页图（默认，走上面的 LLM_BASE_URL / LLM_API_KEY）
# rapidocr：本地离线 OCR（pip install rapidocr-onnxruntime）
OCR_BACKEND=vision
# 视觉模型名；留空则复用 LLM_MODEL
VISION_MODEL=
# 多页并发数（网络等待为主）
VISION_CONCURRENCY=4
# 送图前缩放的最长边（像素），越小越快越省 token
VISION_MAX_SIDE=1600
# vision 失败时是否回退本地 rapidocr
VISION_FALLBACK_LOCAL=1

# ===== 抽取 =====
CONFIDENCE_THRESHOLD=0.75

# ===== 路径（留空使用仓库内默认路径）=====
DATA_DIR=
OUTPUT_DIR=
DB_PATH=
